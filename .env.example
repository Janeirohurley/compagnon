OPENAI_API_KEY=
OMNIROUTE_PROVIDER_ID=omniroute
OMNIROUTE_MODEL=gpt-4o-mini
# Embedding model used by Mastra Memory for semantic recall. The chat model runs
# on OmniRoute, but embeddings are served by OpenRouter (the current OmniRoute
# gateway has no embedding upstream). OPENROUTER_API_KEY must be set for
# embeddings; when it is absent the config below is used against OmniRoute.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OMNIROUTE_EMBEDDING_MODEL=text-embedding-3-small
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1
OMNIROUTE_API_KEY=

# Mastra Memory storage (semantic recall + working memory). Local SQLite by
# default; point at a Turso URL + token for a shared remote database.
TURSO_DATABASE_URL=file:./mastra.db
TURSO_AUTH_TOKEN=
# Key used to encrypt sensitive values at rest (OAuth tokens, connection
# credentials). Must be 32 chars and stable across restarts.
APP_ENCRYPTION_KEY=

# Workspaces (tenancy). Every request can carry a `x-workspace-id` header
# (precedence: header > body `workspaceId` > query `workspaceId` > "default");
# threads, memory, connections and conversations are scoped to that workspace.
# Workspaces are created/listed via the HTTP API (GET /workspaces, POST
# /workspaces with { name, config? }). Per-workspace config is optional:
# - projectPath: root the project-file tools operate on
# - enabledAgents: sub-agents mounted for that workspace
# - model/instructions: model override / extra instructions
# - COMPANION_WORKSPACE_ROOTS / COMPANION_GIT_REPOSITORY remain optional legacy
#   single-workspace hints.
# Daily memory maintenance (dedupe working-memory blocks, drop secret lines,
# prune empty threads/vectors). Unset/empty to disable the schedule.
MEMORY_MAINTENANCE_CRON=0 3 * * *
SSH_PASSWORD=
COMPANION_SSH_CONFIG=
OUTLINE_API_KEY=
OUTLINE_BASE_URL=https://app.getoutline.com/api
GITHUB_TOKEN=
# Web search for the Research Agent. When unset, the research agent has no
# web_search tool and falls back to web fetch + GitHub only.
BRAVE_API_KEY=
COMPANION_WORKSPACE_ROOTS=/home/projets/ai/compagnon
COMPANION_GIT_REPOSITORY=
# Optional: path to the declarative MCP registry (defaults to ./mcp.servers.json)
# COMPANION_MCP_CONFIG=mcp.servers.json
PLANE_API_KEY=
PLANE_WORKSPACE_SLUG=
PLANE_BASE_URL=https://api.plane.so

# Notion MCP (OAuth). The Notion server is declared in mcp.servers.json. Tokens
# are persisted after the interactive OAuth flow (no static token needed). Set
# only if you want to override the default redirect URL.
# NOTION_OAUTH_REDIRECT_URL=http://127.0.0.1:5533/oauth/callback
